{% extends 'base.html.twig' %}

{% block title %}Créer un dossier{% endblock %}

{% block body %}
<div class="h-screen bg-gray-100 flex items-center justify-center p-4">
    
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-8 relative">
        
        {# Close button #}
        <a href="{{ path('app_home') }}" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </a>

        {# Header #}
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Créer un dossier</h2>
            <p class="text-sm text-gray-500">Organisez vos tâches par projet</p>
        </div>

        {{ form_start(form) }}

            {# Nom du dossier #}
            <div class="mb-6">
                {{ form_label(form.name, 'Nom du dossier', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'w-full px-4 py-3 bg-gray-50 border-0 rounded-lg focus:ring-2 focus:ring-blue-500'}}) }}
                {{ form_errors(form.name) }}
            </div>

            {# Couleur #}
            <div class="mb-8">
                {{ form_label(form.color, 'Couleur', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-3'}}) }}
                
                <div class="grid grid-cols-8 gap-3">
                    {% for choice in form.color %}
                        <label class="cursor-pointer">
                            {{ form_widget(choice, {'attr': {'class': 'hidden peer'}}) }}
                            <div class="w-10 h-10 rounded-full peer-checked:ring-4 peer-checked:ring-blue-200 transition-all" 
                                 style="background-color: {{ choice.vars.label }}">
                            </div>
                        </label>
                    {% endfor %}
                </div>
                
                {{ form_errors(form.color) }}
            </div>

            {# Buttons #}
            <div class="flex gap-3">
                <a href="{{ path('app_home') }}" class="flex-1 text-center px-4 py-3 border border-gray-300 rounded-lg font-medium text-gray-700 hover:bg-gray-50 transition">
                    Annuler
                </a>
                <button type="submit" class="flex-1 px-4 py-3 bg-black text-white rounded-lg font-medium hover:bg-gray-800 transition">
                    Créer
                </button>
            </div>

        {{ form_end(form) }}

    </div>

</div>
{% endblock %}

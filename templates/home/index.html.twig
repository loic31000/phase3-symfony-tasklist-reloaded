{% extends 'base.html.twig' %}

{% block title %}Gestion de Tâches{% endblock %}

{% block body %}
<div class="flex h-screen bg-gray-50" data-controller="task-filter">
    
    {# Sidebar #}
    <aside class="w-64 bg-[#f3eeee] text-white flex flex-col">
        <div class="p-4">
            <button data-action="click->task-filter#resetFilters" 
                    class="w-full flex items-center justify-between px-3 py-2 bg-white text-black rounded-lg font-medium hover:bg-gray-100 transition">
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 50 50">
                        <path d="M 24.962891 1.0546875 A 1.0001 1.0001 0 0 0 24.384766 1.2636719 L 1.3847656 19.210938 A 1.0005659 1.0005659 0 0 0 2.6152344 20.789062 L 4 19.708984 L 4 46 A 1.0001 1.0001 0 0 0 5 47 L 18.832031 47 A 1.0001 1.0001 0 0 0 19.158203 47 L 30.832031 47 A 1.0001 1.0001 0 0 0 31.158203 47 L 45 47 A 1.0001 1.0001 0 0 0 46 46 L 46 19.708984 L 47.384766 20.789062 A 1.0005657 1.0005657 0 1 0 48.615234 19.210938 L 41 13.269531 L 41 6 L 35 6 L 35 8.5859375 L 25.615234 1.2636719 A 1.0001 1.0001 0 0 0 24.962891 1.0546875 z M 25 3.3222656 L 44 18.148438 L 44 45 L 32 45 L 32 26 L 18 26 L 18 45 L 6 45 L 6 18.148438 L 25 3.3222656 z M 37 8 L 39 8 L 39 11.708984 L 37 10.146484 L 37 8 z M 20 28 L 30 28 L 30 45 L 20 45 L 20 28 z"/>
                    </svg>
                    <span class="text-sm">Toutes les tâches</span>
                </div>
            </button>
        </div>

        <div class="px-4 py-2">
            <h3 class="text-black text-xs font-semibold uppercase tracking-wider mb-2 px-3">DOSSIERS</h3>
            {% if folders is empty %}
                <p class="text-black text-sm px-3">Aucun dossier créé</p>
            {% else %}
                <ul class="space-y-1">
                    {% for folder in folders %}
                        {% set folderTaskCount = 0 %}
                        {% for task in tasks %}
                            {% if task.folder and task.folder.id == folder.id %}
                                {% set folderTaskCount = folderTaskCount + 1 %}
                            {% endif %}
                        {% endfor %}
                        <li>
                            <button data-action="click->task-filter#selectFolder" 
                                    data-folder-id="{{ folder.id }}"
                                    class="w-full flex items-center justify-between px-3 py-2 rounded-lg hover:bg-black hover:text-white transition-colors text-black">
                                <div class="flex items-center gap-3">
                                    <svg class="w-5 h-5 flex-shrink-0" fill="{{ folder.color ?? '#170603' }}" viewBox="0 0 20 20">
                                        <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
                                    </svg>
                                    <span class="text-sm">{{ folder.name }}</span>
                                </div>
                                <span class="text-xs">{{ folderTaskCount }}</span>
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </aside>

    {# Main Content #}
    <main class="flex-1 flex flex-col">
        
        {# Header #}
        <header class="bg-white border-b border-gray-200 px-8 py-4">
            <div class="flex items-center justify-between mb-2">
                <div>
                    <h1 class="text-2xl font-bold">Gestion de Tâches</h1>
                    <p class="text-gray-500 text-sm">Organisez votre journée efficacement</p>
                </div>
                
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_priority_new') }}" class="flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 50 50">
                            <path d="M 22.205078 2 A 1.0001 1.0001 0 0 0 21.21875 2.8378906 L 20.246094 8.7929688 C 19.076509 9.1331971 17.961243 9.5922728 16.910156 10.164062 L 11.996094 6.6542969 A 1.0001 1.0001 0 0 0 10.708984 6.7597656 L 6.8183594 10.646484 A 1.0001 1.0001 0 0 0 6.7070312 11.927734 L 10.164062 16.873047 C 9.583454 17.930271 9.1142098 19.051824 8.765625 20.232422 L 2.8359375 21.21875 A 1.0001 1.0001 0 0 0 2.0019531 22.205078 L 2.0019531 27.705078 A 1.0001 1.0001 0 0 0 2.8261719 28.691406 L 8.7597656 29.742188 C 9.1064607 30.920739 9.5727226 32.043065 10.154297 33.101562 L 6.6542969 37.998047 A 1.0001 1.0001 0 0 0 6.7597656 39.285156 L 10.648438 43.175781 A 1.0001 1.0001 0 0 0 11.927734 43.289062 L 16.882812 39.820312 C 17.936999 40.39548 19.054994 40.857928 20.228516 41.201172 L 21.21875 47.164062 A 1.0001 1.0001 0 0 0 22.205078 48 L 27.705078 48 A 1.0001 1.0001 0 0 0 28.691406 47.173828 L 29.751953 41.1875 C 30.920633 40.838997 32.033372 40.369697 33.082031 39.791016 L 38.070312 43.291016 A 1.0001 1.0001 0 0 0 39.351562 43.179688 L 43.240234 39.287109 A 1.0001 1.0001 0 0 0 43.34375 37.996094 L 39.787109 33.058594 C 40.355783 32.014958 40.813915 30.908875 41.154297 29.748047 L 47.171875 28.693359 A 1.0001 1.0001 0 0 0 47.998047 27.707031 L 47.998047 22.207031 A 1.0001 1.0001 0 0 0 47.160156 21.220703 L 41.152344 20.238281 C 40.80968 19.078827 40.350281 17.974723 39.78125 16.931641 L 43.289062 11.933594 A 1.0001 1.0001 0 0 0 43.177734 10.652344 L 39.287109 6.7636719 A 1.0001 1.0001 0 0 0 37.996094 6.6601562 L 33.072266 10.201172 C 32.023186 9.6248101 30.909713 9.1579916 29.738281 8.8125 L 28.691406 2.828125 A 1.0001 1.0001 0 0 0 27.705078 2 L 22.205078 2 z M 23.056641 4 L 26.865234 4 L 27.861328 9.6855469 A 1.0001 1.0001 0 0 0 28.603516 10.484375 C 30.066026 10.848832 31.439607 11.426549 32.693359 12.185547 A 1.0001 1.0001 0 0 0 33.794922 12.142578 L 38.474609 8.7792969 L 41.167969 11.472656 L 37.835938 16.220703 A 1.0001 1.0001 0 0 0 37.796875 17.310547 C 38.548366 18.561471 39.118333 19.926379 39.482422 21.380859 A 1.0001 1.0001 0 0 0 40.291016 22.125 L 45.998047 23.058594 L 45.998047 26.867188 L 40.279297 27.871094 A 1.0001 1.0001 0 0 0 39.482422 28.617188 C 39.122545 30.069817 38.552234 31.434687 37.800781 32.685547 A 1.0001 1.0001 0 0 0 37.845703 33.785156 L 41.224609 38.474609 L 38.53125 41.169922 L 33.791016 37.84375 A 1.0001 1.0001 0 0 0 32.697266 37.808594 C 31.44975 38.567585 30.074755 39.148028 28.617188 39.517578 A 1.0001 1.0001 0 0 0 27.876953 40.3125 L 26.867188 46 L 23.052734 46 L 22.111328 40.337891 A 1.0001 1.0001 0 0 0 21.365234 39.53125 C 19.90185 39.170557 18.522094 38.59371 17.259766 37.835938 A 1.0001 1.0001 0 0 0 16.171875 37.875 L 11.46875 41.169922 L 8.7734375 38.470703 L 12.097656 33.824219 A 1.0001 1.0001 0 0 0 12.138672 32.724609 C 11.372652 31.458855 10.793319 30.079213 10.427734 28.609375 A 1.0001 1.0001 0 0 0 9.6328125 27.867188 L 4.0019531 26.867188 L 4.0019531 23.052734 L 9.6289062 22.117188 A 1.0001 1.0001 0 0 0 10.435547 21.373047 C 10.804273 19.898143 11.383325 18.518729 12.146484 17.255859 A 1.0001 1.0001 0 0 0 12.111328 16.164062 L 8.8261719 11.46875 L 11.523438 8.7734375 L 16.185547 12.105469 A 1.0001 1.0001 0 0 0 17.28125 12.148438 C 18.536908 11.394293 19.919867 10.822081 21.384766 10.462891 A 1.0001 1.0001 0 0 0 22.132812 9.6523438 L 23.056641 4 z M 25 17 C 20.593567 17 17 20.593567 17 25 C 17 29.406433 20.593567 33 25 33 C 29.406433 33 33 29.406433 33 25 C 33 20.593567 29.406433 17 25 17 z M 25 19 C 28.325553 19 31 21.674447 31 25 C 31 28.325553 28.325553 31 25 31 C 21.674447 31 19 28.325553 19 25 C 19 21.674447 21.674447 19 25 19 z"/>
                        </svg>
                        <span class="font-medium">Gérer les priorités</span>
                    </a>
                    
                    <a href="{{ path('app_folder_new') }}" class="flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V8a2 2 0 00-2-2h-5L9 4H4zm7 5a1 1 0 10-2 0v1H8a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V9z" clip-rule="evenodd"/>
                        </svg>
                        <span class="font-medium">Nouveau dossier</span>
                    </a>
                    
                    <a href="{{ path('app_task_new') }}" class="flex items-center gap-2 px-4 py-2 bg-black text-white rounded-lg hover:bg-gray-800 text-sm">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"/>
                        </svg>
                        <span class="font-medium">Nouvelle tâche</span>
                    </a>
                    
                    <a href="{{ path('app_logout') }}" class="flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
                        <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                        <span class="font-medium">Déconnexion</span>
                    </a>
                </div>
            </div>
            
            {# Filters #}
            <div class="flex items-center gap-4 mt-4 flex-wrap">
                <button class="flex items-center gap-2 px-3 py-1.5 text-sm text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd"/>
                    </svg>
                    Filtres
                </button>
                
                <div class="flex items-center gap-2">
                    <span class="text-sm text-gray-600">Statut</span>
                    <select data-action="change->task-filter#filterByStatus" 
                            class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg bg-white hover:bg-gray-50 cursor-pointer">
                        <option value="tous">Tous</option>
                        <option value="en_cours">En cours</option>
                        <option value="terminee">Terminée</option>
                        <option value="archivee">Archivée</option>
                    </select>
                </div>
                
                <div class="flex items-center gap-2">
                    <span class="text-sm text-gray-600">Priorité</span>
                    <select data-action="change->task-filter#filterByPriority" 
                            class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg bg-white hover:bg-gray-50 cursor-pointer">
                        <option value="tous">Toutes</option>
                        {% set allPriorities = [] %}
                        {% for task in tasks %}
                            {% if task.priority and task.priority.id not in allPriorities|map(p => p.id) %}
                                {% set allPriorities = allPriorities|merge([task.priority]) %}
                            {% endif %}
                        {% endfor %}
                        {% for priority in allPriorities %}
                            <option value="{{ priority.id }}">{{ priority.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </header>

        {# Content Area #}
        <div class="flex-1 overflow-y-auto p-8">
            {% if tasks is empty %}
                <div class="flex items-center justify-center h-full">
                    <div class="text-center">
                        <p class="text-gray-400 text-lg">Aucune tâche pour le moment. Créez votre première tâche !</p>
                    </div>
                </div>
            {% else %}
                <div class="max-w-4xl mx-auto space-y-3">
                    {% for task in tasks %}
                        <div data-controller="task-checkbox"
                             data-task-checkbox-task-id-value="{{ task.id }}"
                             data-task-checkbox-update-url-value="{{ path('app_task_toggle_status', {id: task.id}) }}"
                             data-task-filter-target="taskCard" 
                             data-status="{{ task.status.value }}" 
                             data-folder="{{ task.folder ? task.folder.id : '' }}" 
                             data-priority="{{ task.priority ? task.priority.id : '' }}"
                             class="bg-white rounded-lg border border-gray-200 p-4 hover:shadow-md transition">
                            <div class="flex items-start justify-between">
                                <div class="flex items-start gap-3 flex-1">
                                    <input type="checkbox" 
                                           data-task-checkbox-target="checkbox"
                                           data-action="change->task-checkbox#toggle"
                                           {{ task.status.value == 'terminee' ? 'checked' : '' }}
                                           {{ task.status.value == 'archivee' ? 'disabled' : '' }}
                                           class="mt-1 w-5 h-5 rounded border-gray-300">
                                    
                                    <div class="flex-1">
                                        <h3 data-task-checkbox-target="title"
                                            class="font-medium {{ task.status.value == 'terminee' ? 'line-through text-gray-500' : 'text-gray-900' }}">
                                            {{ task.title }}
                                        </h3>
                                        <div class="flex items-center gap-3 mt-2 text-sm">
                                            {# Priorité #}
                                            {% if task.priority %}
                                                <span class="inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium" 
                                                      style="background-color: {{ task.priority.color }}20; color: {{ task.priority.color }}">
                                                    {{ task.priority.name }}
                                                </span>
                                            {% endif %}
                                            
                                            {# Statut #}
                                            <span data-task-checkbox-target="status" class="text-gray-500 text-xs">{{ task.status.label }}</span>
                                        </div>
                                    </div>
                                </div>
                                
                                {# Actions #}
                                <div class="flex items-center gap-2">
                                    <button class="p-2 text-gray-400 hover:text-yellow-500" title="Épingler">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M16 12V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v8l-1.5 1.5v1h5V19c0 .55.45 1 1 1s1-.45 1-1v-5.5h5v-1L16 12z"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        
    </main>

</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}

<section class="h-screen bg-gray-300 flex flex-col justify-center items-center">

    <div class="w-full max-w-md bg-white p-8 rounded-lg shadow-lg">

        <h1 class="p-4 m-2">Gestion de tâches </h1>
        <h2>Organisez votre journée efficacement</h2>
        
            <a href="/login" class="flex-1 text-center py-2 text-gray-400 hover:text-gray-700 font-semibold">
            Connexion
            </a>
            <a href="/register" class="flex-1 text-center py-2 m-24 text-black-400 bg-gray-300 rounded-lg font-bold">
            Inscription
            </a>
        
        {{ form_errors(registrationForm) }}
        
        {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}


            <div>
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'bg-gray-300 rounded-lg'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.email) }}</div>
            </div>

            <div>
                {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.username, {'attr': {'class': 'bg-gray-300 rounded-lg'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.username) }}</div>
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class':'bg-gray-300 rounded-lg'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.plainPassword) }}</div>
            </div>

            <div class="flex items-center gap-2 py-2">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'h-4 w-4 text-black-600 '}}) }}
                {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'text-gray-600'}}) }}
            </div>
            
            <button type="submit" class="w-full text-white-400 bg-black-500">
                S'inscrire
            </button>

        {{ form_end(registrationForm) }}
    </div>

</section>
{% endblock %}